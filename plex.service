[Unit]
Description=Plex container
Requires=docker.service docker.socket
After=docker.service docker.socket
ConditionPathIsDirectory=/tank/plex

[Service]
Restart=always
RestartSec=30
Environment=DOCKER_UID=2004 DOCKER_GID=2004

# No image pull here: boot/start must be fast and network-order-independent.
# Updates are fetched out-of-band by plex-update.timer and applied on the next
# (re)start. `docker run` still auto-pulls if the image is entirely missing.
ExecStart=/usr/bin/docker run \
    --rm \
    --name=plex \
    --net=host \
    --device=/dev/dri:/dev/dri \
    -e TZ='America/New_York' \
    -e PLEX_UID=${DOCKER_UID} \
    -e PLEX_GID=${DOCKER_GID} \
    -v /tank/plex:/config \
    -v /var/plex:/transcode \
    -v /export/tv:/data/tv \
    -v /export/movies:/data/movies \
    -v /export/music:/data/music \
    --health-cmd='curl --head --fail http://0.0.0.0:32400/web/index.html || exit 1' \
    --health-interval=60s \
    --health-retries=3 \
    --health-timeout=5s \
    --health-start-period=3m \
    plexinc/pms-docker:latest

ExecStop=/usr/bin/docker stop --time 5 plex

[Install]
WantedBy=multi-user.target
